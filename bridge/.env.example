# LazySyndic → Jarvis bridge — copy to bridge/.env (chmod 600) OR use as a
# systemd EnvironmentFile. NEVER commit the filled-in file (bridge/.env is gitignored).

# Supabase (SAME project as LazyPO/LazySyndic). The service_role key is SECRET and
# bypasses RLS — it lives ONLY here on the server, never in the browser or in Jarvis.
#   Supabase → Project Settings → API → Project URL / service_role (secret)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Bearer that Jarvis must present on GET /api/jarvis/alerts (≥ 16 chars).
# Put the SAME value in Jarvis's LAZYSYNDIC_API_TOKEN.  Generate: openssl rand -base64 24
BRIDGE_TOKEN=

# The bridge listens on localhost only (Jarvis calls it in-VPS). Keep HOST=127.0.0.1
# so the service_role-backed endpoint is never publicly reachable.
HOST=127.0.0.1
PORT=3011

# "documents" = manual timeline entries newer than this many days (heuristic; tune).
DOCUMENT_WINDOW_DAYS=60

# --- Optional push (webhook to Jarvis when a new alert appears) ---------------
# Leave POLL_MS=0 to disable push (Jarvis still pulls on refresh).
# Same VPS as Jarvis → call the webhook over localhost (secret must match Jarvis's
# LAZYSYNDIC_WEBHOOK_SECRET). POLL_MS e.g. 300000 = check every 5 min.
JARVIS_WEBHOOK_URL=http://127.0.0.1:3007/api/lazysyndic/webhook
JARVIS_WEBHOOK_SECRET=
POLL_MS=0
